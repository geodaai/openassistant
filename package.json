{
  "name": "openassistant",
  "version": "1.0.0-alpha.1",
  "description": "AI Assistant for spatial data analysis and visualization with kepler.gl",
  "author": "Xun Li<lixun910@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -i ./src/styles/input.css -o ./dist/styles.css --minify",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./dist/styles.css --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
